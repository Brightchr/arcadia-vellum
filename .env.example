# Postgres connection string.
# Local dev (docker-compose): postgresql://postgres:postgres@localhost:5433/witchjournal
# Railway: use the DATABASE_URL from the Postgres plugin (internal hostname).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/witchjournal

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# The canonical URL of the app (http://localhost:3000 locally, your Railway URL in prod).
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud OAuth client (see README for setup steps). Optional for local
# email/password-only development; required for Google sign-in and Doc linking.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key + project number for the Google Picker (client-side, hence NEXT_PUBLIC).
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# S3-compatible object storage for media (audio, covers, avatars).
# Optional: with these unset, media bytes are stored in Postgres (fine for
# small local dev; NOT recommended in production — the DB fills up fast).
# Railway: create a Storage Bucket and copy its credentials panel here.
# Local dev: docker compose up minio, then use the values below.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint URL (Railway: https://t3.storageapi.dev; MinIO: http://localhost:9000)
S3_ENDPOINT=
S3_REGION=auto
# "true" for MinIO and most S3-compatibles
S3_FORCE_PATH_STYLE=true

# Web Push (device notifications for mentions/invites/friend requests).
# Optional — without keys, push quietly disables. Generate a pair once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# App-level country block (backstop behind Cloudflare's WAF geo rule).
# Comma-separated ISO country codes; unset = disabled.
BLOCKED_COUNTRIES=

# Cloudflare Turnstile challenge on email sign-in/sign-up. Create a widget at
# dash.cloudflare.com → Turnstile, then set BOTH keys (either alone disables
# the challenge). Leave unset in local dev.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Origin lock: refuse requests that didn't come through Cloudflare.
# Generate a secret (openssl rand -hex 32), set it here, and add a Cloudflare
# Transform Rule (Rules → Transform → Modify Request Header) that sets
# X-Origin-Auth to the same value on all requests. Unset = disabled.
# Leave unset in local dev.
ORIGIN_SECRET=
